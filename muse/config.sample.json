{
  "_about": "Sample configuration for coach_monitor.py. Copy to coach_config.json and adjust the paths and heart-rate bands to your environment. Relative paths are resolved against the process working directory, so either launch the monitor from this folder or replace them with absolute paths. Runtime data lives under ./state and ./queue. hr_bands are one runner's example (resting HR ~55, LTHR ~158): set your own.",
  "audio": true,
  "close": {
    "standby_session": "standby",
    "wait_before_standby_sec": 60
  },
  "closing_attempts": 4,
  "closing_text": "{distance}キロ。平均ペースはキロ{pace}でした。おつかれさまでした。",
  "hr_bands": [
    {
      "max": 120,
      "label": "max_ok"
    },
    {
      "max": 135,
      "label": "ok"
    },
    {
      "max": 150,
      "label": "slightly_high"
    }
  ],
  "no_live_closing_text": "ライブデータは観測できませんでした。おつかれさまでした。",
  "poll_fail_abort": 30,
  "poll_interval_sec": 20,
  "poll_script": "./livetrack_poll.py",
  "publish_script": "./publish.py",
  "queue_json": "./queue/queue.json",
  "say_attempts": 3,
  "say_retry_backoff_sec": 5,
  "send_mode": "per_km",
  "stale_finish_sec": 600,
  "state_dir": "./state",
  "stock_file": "./comment_stock.json",
  "target_pace": {
    "fast_limit_sec": 330
  },
  "fast_advice_cooldown_sec": 600,
  "hydration": {
    "enabled": true,
    "every_min": 40,
    "min_run_min": 75
  },
  "milestones_km": [
    5,
    10,
    15,
    20,
    25,
    30,
    35,
    40
  ],
  "start_announce_text": "監視を開始しました。",
  "tts_fallback": true,
  "timezone_offset_hours": 9,
  "max_duration_min": 360,
  "max_messages": 200,
  "send_interval_sec": 60,
  "progress_every": 0,
  "motivational_every": 0,
  "altitude": {
    "enabled": true,
    "downhill_net_loss_m": 20,
    "climb_gain_m": 20,
    "finish_ascent_m": 50
  }
}
